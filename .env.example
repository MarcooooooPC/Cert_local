# Configuración del portal de certificados. Copia este archivo como .env en la misma carpeta y complétalo.
# No compartir ni subir a repositorios: el .env real contiene la clave de la base de datos.
# Usa comillas dobles si un valor tiene espacios, # o = (por ejemplo la clave).

DB_DRIVER="mysql"            # mysql (producción) | sqlite (solo pruebas)
DB_HOST="localhost"
DB_NAME="u123456789_certs"
DB_USER="u123456789_user"
DB_PASS=""
APP_DEBUG="false"            # true muestra errores de PHP: nunca en producción

# Opcionales
# DB_SQLITE_PATH="/ruta/absoluta/data.sqlite"
# UPLOADS_DIR="/ruta/absoluta/uploads/templates"
# BACKUPS_DIR="/ruta/absoluta/storage/backups"
